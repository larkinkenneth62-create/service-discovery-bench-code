{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servicediscoverybench.local/schemas/v0.2.0/task.schema.json",
  "title": "ServiceDiscoveryBench v0.2.0 public task row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_task_id",
    "underlying_task_id",
    "paired_task_group_id",
    "split_group_id",
    "task_type",
    "prediction_target",
    "source_dataset",
    "source_subset",
    "query_text",
    "user_visible_context_json",
    "candidate_services_json",
    "candidate_apis_json",
    "gold_services_json",
    "gold_apis_json",
    "acceptable_gold_service_sets_json",
    "acceptable_gold_api_sets_json",
    "service_api_map_json",
    "dependency_graph_json",
    "candidate_count",
    "gold_count",
    "query_signature",
    "task_signature",
    "signature_version",
    "legacy_split",
    "legacy_split_group_id",
    "split_identity_group_v3",
    "split_version",
    "split"
  ],
  "properties": {
    "benchmark_task_id": {"type": "string", "minLength": 1},
    "underlying_task_id": {"type": "string", "minLength": 1},
    "paired_task_group_id": {"type": "string", "minLength": 1},
    "split_group_id": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["single_service_discovery", "single_api_recommendation", "multi_service_discovery", "multi_api_recommendation", "composable_service_discovery", "composable_api_recommendation"]},
    "prediction_target": {"enum": ["service", "api"]},
    "source_dataset": {"type": "string", "minLength": 1},
    "source_subset": {"type": "string", "minLength": 1},
    "query_text": {"type": "string", "minLength": 1},
    "user_visible_context_json": {"type": "string"},
    "candidate_services_json": {"type": "string"},
    "candidate_apis_json": {"type": "string"},
    "gold_services_json": {"type": "string"},
    "gold_apis_json": {"type": "string"},
    "acceptable_gold_service_sets_json": {"type": "string"},
    "acceptable_gold_api_sets_json": {"type": "string"},
    "service_api_map_json": {"type": "string"},
    "dependency_graph_json": {"type": "string"},
    "candidate_count": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "gold_count": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "query_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_version": {"type": "string", "minLength": 1},
    "legacy_split": {"type": "string", "minLength": 1},
    "legacy_split_group_id": {"type": "string", "minLength": 1},
    "split_identity_group_v3": {"type": "string", "minLength": 1},
    "split_version": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "dev", "test"]}
  }
}
